{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrustRepro",
  "version": "0.2.7",
  "identifier": "org.trustrepro.desktop",
  "build": { "frontendDist": "../bootstrap" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; form-action http://127.0.0.1:*; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png"],
    "resources": {
      "../../../var/windows/bundle/": "runtime/",
      "installer.LICENSE-MIT": "notices/tauri-installer-LICENSE-MIT"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "template": "installer.nsi",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
