TRUSTREPRO_DATABASE_URL=postgresql+psycopg://trustrepro:trustrepro_dev@127.0.0.1:5432/trustrepro
TRUSTREPRO_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
TRUSTREPRO_MODEL_BASE_URL=http://host.docker.internal:8317/v1
TRUSTREPRO_MODEL_API_KEY=
TRUSTREPRO_MODEL_NAME=gpt-6.1-sol
# CNY per million observable tokens; not an upstream billing statement.
TRUSTREPRO_MODEL_PRICE_CURRENCY=CNY
TRUSTREPRO_USD_TO_CNY_RATE=6.7
TRUSTREPRO_MODEL_INPUT_COST_PER_MILLION=6.7
TRUSTREPRO_MODEL_OUTPUT_COST_PER_MILLION=33.5
TRUSTREPRO_MODEL_UNKNOWN_RESERVATION=1.005
TRUSTREPRO_CODEX_VERSION=0.154.0
# Compose uses named volumes; no Windows runtime bind mount or Manager API token.
